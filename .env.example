# Copy to .env for local development. In production, set these in the host's
# secret store instead of a file. See DEPLOY.md.

# "production" makes the API refuse to start with unsafe values below.
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://klinkrr:localdev@localhost:5432/klinkrr

# File storage: MinIO locally (docker-compose). In production use S3 or R2,
# e.g. S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com, AWS_REGION=auto
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=file-approval
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# OAuth. Register <API URL>/admin/auth/<provider>/callback as the redirect URL.
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT=common
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_SELF_SERVE_ENABLED=false
FRONTEND_URL=http://localhost:5173

# App
# Production: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-in-production-use-a-real-secret
ALLOWED_ORIGINS=http://localhost:5173
# Only used to create the first owner when there are no users. Remove after
# the first boot and change the password in Settings.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# Needed for redirect links; without it, link submissions return 503.
WEB_RISK_API_KEY=

# How long a public link can serve a just-replaced version (seconds).
CACHE_TTL_SECONDS=5
# Public "access" audit events older than this are pruned by
# `python -m backend.scripts.prune_audit_logs`.
AUDIT_ACCESS_RETENTION_DAYS=90
